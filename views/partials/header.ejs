<div style="display: flex; align-items: center; justify-content: space-between;">
    <img src="/images/logo.png" alt="Header Logo" style="transform: translate(-24%);" class="logo-img" />
    <a class="language-switch" href="/?lang=<%= lang %>">
        <img src="/icons/globe.svg" alt="Language Icon" />
        <div class="disappearing-text typography-body2" style="color: var(--black)">
            <%= header.changeLang %>
        </div>
    </a>
</div>