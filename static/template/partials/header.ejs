<div style="display: flex; align-items: center; justify-content: space-between;">
    <img src="/logo.png" alt="Header Logo" style="transform: translate(-24%);" class="logo-img" />
    <button class="language-switch" onClick="switchLang()">
        <img src="/globe.svg" alt="Language Icon" />
        <div class="disappearing-text typography-body2" style="color: var(--black)">
            <%= changeLang %>
        </div>
    </button>
</div>